# Vitality environment variables.
# Copy this file to `.env.local` (gitignored) and fill in real values.
# Only the Supabase block is required — everything else is optional and the
# app degrades gracefully (features tell the user they aren't configured).

# --- Supabase (REQUIRED) ---
# Create a free project at https://supabase.com, then:
#   Project Settings → API → Project URL / anon key / service_role key
# Apply the schema with the Supabase CLI: `supabase link` + `supabase db push`
# (migrations live in supabase/migrations/).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role: NEVER commit, NEVER expose to the client. Server-only.
SUPABASE_SERVICE_ROLE_KEY=

# --- App base URL ---
# Absolute origin of this deployment; used to build OAuth redirect URLs.
# Dev: http://localhost:3000 · Prod: https://<your-domain>
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public site URL for robots.txt/sitemap.xml (falls back to localhost).
NEXT_PUBLIC_SITE_URL=

# --- Anthropic / Claude (AI mentor, brand intake, food-photo analysis, Forge) ---
# Server-only. https://console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=
# Optional model override.
CLAUDE_MODEL=claude-sonnet-5

# --- Stripe (optional paid tiers) ---
# Test keys from https://dashboard.stripe.com/test/apikeys.
# Run `node scripts/stripe-bootstrap.mjs` to create the product + price.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Reserved — checkout is fully server-side, so nothing reads this today.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- WHOOP (wearable recovery/sleep/strain) — BRING-YOUR-OWN-CREDENTIALS ---
# Each user pastes their own WHOOP app's client_id/secret in-app (stored
# per-user), so no global WHOOP keys are needed. Only the redirect URI is
# global — it gates whether WHOOP appears in the vitals gallery.
#   dev  → http://localhost:3000/api/whoop/callback
#   prod → https://<your-domain>/api/whoop/callback
WHOOP_REDIRECT_URI=http://localhost:3000/api/whoop/callback
# Legacy shared-app credentials (unused in BYO mode, safe to leave blank).
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# --- Fitbit (wearable steps/sleep) — one shared OAuth app for all users ---
# Register at https://dev.fitbit.com (OAuth 2.0 Application Type: Server).
# The registered Redirect URI must match FITBIT_REDIRECT_URI exactly.
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=http://localhost:3000/api/fitbit/callback

# --- Oura (wearable recovery/sleep) — one shared OAuth app for all users ---
# Register at https://cloud.ouraring.com/oauth/applications.
# Also gates whether Oura appears in the vitals gallery.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://localhost:3000/api/oura/callback

# --- Nutrition (Fuel module) ---
# Free key, instant: https://fdc.nal.usda.gov/api-key-signup.html
# Open Food Facts barcode lookups need no key.
USDA_API_KEY=

# --- Finance module ---
# Free tier: https://finnhub.io/register (60 calls/min). Server-only.
FINNHUB_API_KEY=
# Optional; CoinGecko's keyless endpoints are used when unset.
COINGECKO_API_KEY=

# --- YouTube Data API v3 (Brand module: channel refresh + recent videos) ---
# https://console.cloud.google.com → enable "YouTube Data API v3" → API key.
YOUTUBE_API_KEY=

# --- Google / Gmail OAuth (email-based wearable import, optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional inbound-email ingest domain for the Cloudflare worker in workers/.
NEXT_PUBLIC_EMAIL_INGEST_DOMAIN=

# --- Other connectors (all optional) ---
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_WEBHOOK_SECRET=

# --- Hosted MCP (connect Claude to the dashboard; optional) ---
# The MCP endpoint lives at <NEXT_PUBLIC_APP_URL>/api/mcp/mcp.
# Dark-launch flag: route + OAuth endpoints 404 unless exactly "true".
MCP_ENABLED=false
# Supabase project's LEGACY HS256 JWT secret (Settings → API → JWT Keys →
# Legacy JWT Secret). Used only to mint short-lived RLS JWTs.
SUPABASE_JWT_SECRET=
# Dedicated HS256 secret for signing MCP OAuth access tokens. Any long
# random string — keep it separate from SUPABASE_JWT_SECRET.
MCP_OAUTH_SIGNING_SECRET=
MCP_CHECK_PROOF_SECRET=

# --- Cron + admin ---
# Shared secret protecting /api/cron/* routes (set the same value in your
# scheduler, e.g. Vercel Cron).
CRON_SECRET=
# Comma-separated emails whose accounts see dogfood/curation surfaces.
FOUNDER_EMAILS=
# Protects the dev seed route (/api/dev/seed-whoop).
SEED_KEY=

# --- Sentry (optional error monitoring) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Misc ---
# IANA timezone used by server-side day boundaries (defaults to UTC).
VITALITY_TIMEZONE=
# Optional Amazon affiliate tag for supplement links.
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=
# Optional self-hosted Plausible analytics host.
PLAUSIBLE_HOST=

# --- Optional: project a daily summary into a second Supabase store ---
# Lets a household/team mirror one user's wearable summary into a shared
# dashboard. All four must be set together or the nightly cron skips it.
SHARED_BRAIN_SUPABASE_URL=
SHARED_BRAIN_SUPABASE_ANON_KEY=
SHARED_BRAIN_OWNER_KEY=
WHOOP_SHARED_PROVIDER_USER_ID=

# --- Test-user reset script (scripts/reset-test-user.mjs, dev only) ---
VITALITY_USER_EMAIL=
VITALITY_USER_PASSWORD=
VITALITY_USER_ID=
VITALITY_SUPABASE_SERVICE_ROLE_KEY=
